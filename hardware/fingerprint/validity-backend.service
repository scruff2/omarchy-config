[Unit]
Description=Validity 138a:0097 fingerprint sensor backend
Requires=fprintd.service
After=fprintd.service

[Service]
ExecStart=/usr/bin/python /opt/validity-0097/validity-service
Environment=PYTHONPATH=/opt/validity-0097
StateDirectory=python-validity
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
